    %% Users and accounts
    Account "1" -- "0..1" PharmacyStaff : acts-as
    Account "1" -- "0..1" Admin : acts-as
    PharmacyStaff "1..*" -- "1" Pharmacy : works-at
    SecurityCode "0..*" -- "1" Account : issued-to
    Notification "0..*" -- "1" Account : addressed-to

    %% Pharmacy, location and verification
    Pharmacy "1" -- "1" Location : located-at
    Pharmacy "1" -- "1..*" VerificationRequest : undergoes
    VerificationRequest "1" -- "1..*" LicenseDocument : supported-by
    Admin "0..1" -- "0..*" VerificationRequest : reviews

    %% Catalog and listings
    Product "1..*" -- "1" DrugReferenceEntry : described-by
    Product "1" -- "0..*" Listing : listed-as
    Pharmacy "1" -- "0..*" Listing : stocks

    %% Feed import and synchronisation
    Pharmacy "1" -- "0..1" AutomaticFeed : configures
    Pharmacy "1" -- "0..*" FeedImport : submits
    AutomaticFeed "0..1" -- "0..*" FeedImport : produces
    FeedImport "0..*" -- "0..*" Listing : updates
    FeedImport "1" -- "1" SyncLog : recorded-in
    Pharmacy "1" -- "0..*" SyncLog : synced-by

    %% Background jobs and notifications
    ScheduledJob "0..1" -- "0..*" FeedImport : triggers
    ScheduledJob "0..1" -- "0..*" Notification : triggers

    %% Searching and directions
    Consumer "1" -- "0..*" Search : performs
    Search "0..*" -- "1" Product : looks-for
    Search "0..*" -- "0..*" Listing : returns
    Search "0..*" -- "1" Location : originates-at
    Consumer "0..*" -- "0..*" Pharmacy : gets-directions-to