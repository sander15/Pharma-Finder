sequenceDiagram
    autonumber
    actor U as User
    participant C as C: Consumer
    participant CA as CA: ClientApp
    participant API as API: RestApi
    participant AUTH as AUTH: AccessAndAuthentication
    participant S as S: Search
    participant OL as OL: Location (search origin)
    participant P as P: Product (one per presentation)
    participant LST as LST: Listing
    participant PH as PH: Pharmacy
    participant PL as PL: Location (pharmacy)
    participant DB as DB: RelationalDbGeo


    %% ---------- Part 1: search, asking for wheelchair access if needed ----------
    U->>C: searchMedicine (medicineName, needsAccessibleAccess)
    C->>CA: showSearchForm ()
    CA->>API: receiveRequest (medicineName, currentLocation, needsAccessibleAccess)
    API->>API: validateInput ()
    API->>AUTH: authorize (request)
    AUTH-->>API: authorized (consumers can search without logging in)
    API->>API: routeRequest ()
    API->>S: matchProduct (medicineName, origin)

    %% --- Step A: one name can match several presentations ---
    S->>P: matchesName (medicineName)
    P->>DB: query (brandName or genericName like medicineName)
    DB-->>P: one product record per presentation and dosage
    P-->>S: matched Products (e.g. 500 mg tablet, 250 mg/5 ml syrup)

    S->>OL: toCoordinates ()
    OL-->>S: origin coordinates

    %% --- Step B: collect listings separately for EACH presentation ---
    S->>S: findListings ()
    loop for each matched presentation
        S->>P: getListings ()
        P->>DB: query (listings of this presentation)
        DB-->>P: listing records
        P-->>S: listings (stock, price, lastUpdated)

        loop for each listing of this presentation
            S->>LST: isInStock ()
            LST->>PH: isVisibleInSearch ()
            PH->>PH: isVerified ()
            alt pharmacy is verified
                PH->>PL: distanceTo (origin coordinates)
                PL->>DB: geoQuery (pharmacy coordinates, origin coordinates)
                DB-->>PL: distance in km
                PL-->>PH: distance in km
                PH-->>LST: visible (pharmacy name, distance, isAccessible)
            else pharmacy is not verified
                PH-->>LST: hidden
            end
            LST-->>S: exact stock for THIS presentation, price, lastUpdated, pharmacy info
        end
    end

    %% --- Step C: Search filters and sorts ---
    S->>S: filterVerifiedOnly ()
    opt needsAccessibleAccess is true
        S->>S: filterAccessible ()
    end
    S->>S: rankByDistance ()
    S-->>API: results grouped by pharmacy, one line per presentation, nearest first
    API-->>CA: sendJsonResponse (ranked results)

    %% ---------- Part 2: show every presentation clearly + the accessibility flag ----------
    CA->>CA: showResults (pharmacy, presentation, dosage, stock status, price, lastUpdated)
    alt accessibility data is available for the pharmacy
        CA->>CA: showResults (add wheelchair-accessible flag)
    else no accessibility data
        CA->>CA: showResults (no flag shown)
    end
    CA-->>C: results displayed
    C-->>U: one line per presentation and pharmacy, not a single yes/no

    %% ---------- Part 3: the user confirms the exact item ----------
    U->>C: compareResults ()
    C->>CA: showComparison ()
    Note over CA: Data is already inside the JSON response, so no new request is needed
    CA-->>C: presentations and dosages side by side per pharmacy
    C-->>U: comparison of exact items

    opt user opens one pharmacy to double-check
        U->>C: compareResults (selected pharmacy)
        C->>CA: showPharmacyDetails ()
        CA-->>C: presentation, dosage, stock, price, accessibility, lastUpdated
        C-->>U: confirmed details for that pharmacy
    end