flowchart TD
    Consumer["«actor - Outside layers»<br>Consumer"]
    Search["«entity - Layer 3»<br>Search"]
    Account["«entity - Layer 2»<br>Account"]
    Staff["«actor - Outside layers»<br>Pharmacy Staff"]
    Admin["«actor - Outside layers»<br>Admin"]
    Pharmacy["«entity - Layer 3»<br>Pharmacy"]
    Location["«entity - Layer 3»<br>Location (geo)"]
    Verification["«entity - Layer 3»<br>Verification Request"]
    License["«entity - Layer 3»<br>License Document"]
    Product["«entity - Layer 3»<br>Product"]
    DrugRef["«entity - Layer 3»<br>Drug Reference Entry"]
    Listing["«entity - Layer 3»<br>Listing (stock, price)"]
    AutoFeed["«entity - Layer 3»<br>Automatic Feed (POS)"]
    FeedImport["«entity - Layer 3»<br>Feed Import"]
    SyncLog["«entity - Layer 3»<br>Sync Log"]
    Notification["«entity - Layer 3»<br>Notification"]
    SecCode["«entity - Layer 2»<br>Security Code"]
    Job["«entity - Layer 3»<br>Scheduled Job"]

    %% Layer 1 UI (boundary)
    ClientApp["«boundary - Layer 1»<br>Client App"]
    Portal["«boundary - Layer 1»<br>Pharmacy Portal"]
    Console["«boundary - Layer 1»<br>Admin Console"]

    %% Layer 2 (control)
    RestApi["«control - Layer 2»<br>REST API"]
    AuthSvc["«control - Layer 2»<br>Access and Authentication"]

    %% Layer 4 (storage and adapters)
    Db["«service - Layer 4»<br>Relational DB with Geo Extension"]
    Files["«service - Layer 4»<br>File Storage"]
    EmailA["«interface - Layer 4»<br>Email Adapter"]
    DrugA["«interface - Layer 4»<br>Drug Reference Adapter"]
    PosA["«interface - Layer 4»<br>POS Feed Connector"]
    LicA["«interface - Layer 4»<br>License Check Adapter"]
    DirA["«interface - Layer 4»<br>Directions Adapter"]
    GeoA["«interface - Layer 4»<br>Geocoding Adapter"]

    %% Users and accounts
    Account ---|"1 / 0..1<br>acts-as"| Staff
    Account ---|"1 / 0..1<br>acts-as"| Admin
    Staff ---|"1..* / 1<br>works-at"| Pharmacy
    SecCode ---|"0..* / 1<br>issued-to"| Account
    Notification ---|"0..* / 1<br>addressed-to"| Account

    %% Pharmacy, location and verification
    Pharmacy ---|"1 / 1<br>located-at"| Location
    Pharmacy ---|"1 / 1..*<br>undergoes"| Verification
    Verification ---|"1 / 1..*<br>supported-by"| License
    Admin ---|"0..1 / 0..*<br>reviews"| Verification

    %% Catalog and listings
    Product ---|"1..* / 1<br>described-by"| DrugRef
    Product ---|"1 / 0..*<br>listed-as"| Listing
    Pharmacy ---|"1 / 0..*<br>stocks"| Listing

    %% Feed import and synchronisation
    Pharmacy ---|"1 / 0..1<br>configures"| AutoFeed
    Pharmacy ---|"1 / 0..*<br>submits"| FeedImport
    AutoFeed ---|"0..1 / 0..*<br>produces"| FeedImport
    FeedImport ---|"0..* / 0..*<br>updates"| Listing
    FeedImport ---|"1 / 1<br>recorded-in"| SyncLog
    Pharmacy ---|"1 / 0..*<br>synced-by"| SyncLog

    %% Background jobs and notifications
    Job ---|"0..1 / 0..*<br>triggers"| FeedImport
    Job ---|"0..1 / 0..*<br>triggers / retries"| Notification
    Job ---|"0..* / 0..*<br>triggers pulls of"| AutoFeed
    Job ---|"0..* / 0..*<br>checks stale-sync of"| SyncLog
    Job ---|"0..* / 0..*<br>refreshes"| DrugRef

    %% Searching and directions
    Consumer ---|"1 / 0..*<br>performs"| Search
    Search ---|"0..* / 1<br>looks-for"| Product
    Search ---|"0..* / 0..*<br>returns"| Listing
    Search ---|"0..* / 1<br>originates-at"| Location
    Consumer ---|"0..* / 0..*<br>gets-directions-to"| Pharmacy

    %% Security code delivery
    SecCode ---|"0..1 / 0..1<br>delivered-by"| Notification

    %% Layer 1: who uses which UI
    Consumer -.->|"uses"| ClientApp
    Staff -.->|"uses"| Portal
    Admin -.->|"uses"| Console

    %% Layer 1 -> Layer 2
    ClientApp -.->|"HTTPS requests"| RestApi
    Portal -.->|"HTTPS requests"| RestApi
    Console -.->|"HTTPS requests"| RestApi
    RestApi -.->|"authorizes each call"| AuthSvc

    %% Layer 2 -> domain
    RestApi -.->|"routes searches"| Search
    RestApi -.->|"routes manual edits"| Listing
    RestApi -.->|"routes uploads"| FeedImport
    RestApi -.->|"routes reviews"| Verification
    RestApi -.->|"routes registration and profiles"| Pharmacy
    AuthSvc -.->|"authenticates"| Account
    AuthSvc -.->|"issues and checks"| SecCode

    %% Domain -> Layer 4
    License -.->|"stored-in"| Files
    FeedImport -.->|"keeps file copy"| Files
    Notification -.->|"sent-through"| EmailA
    DrugRef -.->|"fetched-via"| DrugA
    AutoFeed -.->|"pulls-via"| PosA
    Verification -.->|"checked-via"| LicA
    Search -.->|"routes-via"| DirA
    Location -.->|"geocoded-via"| GeoA
    PosA -.->|"1..*<br>connects-to"| Pharmacy

    %% Domain -> Layer 4 (Relational DB with Geo Extension)
    Account -.->|"stored-in"| Db
    Pharmacy -.->|"stored-in"| Db
    Location -.->|"stored-in (geo)"| Db
    Product -.->|"stored-in"| Db
    Listing -.->|"stored-in"| Db
    SyncLog -.->|"stored-in"| Db
    Job -.->|"stored-in (job table)"| Db

    classDef boundary fill:#fef9c3,stroke:#a16207;
    classDef control fill:#ede9fe,stroke:#6d28d9;
    classDef infra fill:#ffedd5,stroke:#c2410c,stroke-dasharray:4 2;
    class ClientApp,Portal,Console boundary;
    class RestApi,AuthSvc control;
    class Db,Files,EmailA,DrugA,PosA,LicA,DirA,GeoA infra;