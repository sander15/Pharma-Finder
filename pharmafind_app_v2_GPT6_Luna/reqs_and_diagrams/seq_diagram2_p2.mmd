sequenceDiagram
    autonumber
    actor U as Pharmacy Manager
    participant PS as PS: PharmacyStaff
    participant PP as PP: PharmacyPortal
    participant API as API: RestApi
    participant AUTH as AUTH: AccessAndAuthentication
    participant ACC as ACC: Account
    participant PH as PH: Pharmacy
    participant LST as LST: Listing
    participant DB as DB: RelationalDbGeo
    participant SL as SL: SyncLog
    participant JOB as JOB: ScheduledJob
    participant NTF as NTF: Notification
    participant EA as EA: EmailAdapter

    %% ---------- Part 0: the manager logs in ----------
    U->>PS: viewLastSync ()
    PS->>PP: showLogin ()
    PP-->>PS: login form shown
    PS-->>U: asks for email and password
    PP->>API: receiveRequest (email, password)
    API->>API: validateInput ()
    API->>AUTH: authenticate (email, password)
    AUTH->>ACC: login ()
    ACC->>DB: query (account with this email)
    DB-->>ACC: account record
    ACC-->>AUTH: credentials correct or not
    alt credentials are correct
        AUTH->>AUTH: issueSessionToken ()
        AUTH-->>API: session token
        API-->>PP: sendJsonResponse (session token)
        PP-->>PS: logged in
        Note over U,PS: From now on every request carries the session token
    else credentials are wrong
        AUTH-->>API: login failed
        API-->>PP: sendJsonResponse (error: wrong email or password)
        PP->>PP: showLogin (error message, try again)
        Note over U,PS: The rest of this diagram assumes the login succeeded
    end

    %% ---------- Part 1: when was my data last updated? ----------
    PS->>PP: showSyncDashboard ()
    PP->>API: receiveRequest (pharmacyId)
    API->>API: validateInput ()
    API->>AUTH: authorize (request)
    AUTH->>AUTH: checkPharmacyScope ()
    AUTH->>ACC: canAccessPharmacy (pharmacyId)
    ACC-->>AUTH: yes (own pharmacy)
    AUTH-->>API: authorized
    API->>API: routeRequest ()
    API->>PH: isSyncStale ()
    PH->>SL: getLatestFor (pharmacy)
    SL->>DB: query (latest sync log of this pharmacy)
    DB-->>SL: latest sync log
    SL-->>PH: last sync time and result
    PH->>SL: isOlderThan (24 hours)
    SL-->>PH: true or false
    PH-->>API: lastSyncAt, isStale
    API-->>PP: sendJsonResponse (lastSyncAt, isStale)
    alt data synced within the last 24 hours
        PP->>PP: showSyncDashboard (last sync time, status OK)
    else data is stale
        PP->>PP: showSyncDashboard (last sync time, warning banner)
    end
    PP-->>PS: dashboard shown
    PS-->>U: last sync time and status

    %% ---------- Part 2: how does my listing look to searchers? ----------
    U->>PS: previewPublicListing ()
    PS->>PP: showListingPreview ()
    PP->>API: receiveRequest (pharmacyId)
    API->>API: validateInput ()
    API->>AUTH: authorize (request)
    AUTH-->>API: authorized (own pharmacy only, same scope check as Part 1)
    API->>API: routeRequest ()
    API->>PH: getListings ()
    PH->>DB: query (listings of this pharmacy)
    DB-->>PH: listing records
    PH->>PH: isVisibleInSearch ()
    PH->>PH: isVerified ()
    loop for each listing of this pharmacy
        PH->>LST: isInStock ()
        LST-->>PH: stock status
    end
    PH-->>API: listings as searchers see them (stock status, price, lastUpdated, verified or not)
    API-->>PP: sendJsonResponse (public preview)
    PP->>PP: showListingPreview (public preview)
    PP-->>PS: preview shown
    PS-->>U: what searchers will see

    %% ---------- Part 3: automatic alert when a sync is late (runs in the background) ----------
    Note over JOB: This part runs on its own. The manager does not click anything
    JOB->>JOB: isDue ()
    alt the stale-sync job is due
        JOB->>JOB: execute ()
        JOB->>JOB: checkStaleSync ()
        loop for each pharmacy
            JOB->>SL: getLatestFor (pharmacy)
            SL->>DB: query (latest sync log of this pharmacy)
            DB-->>SL: latest sync log
            SL-->>JOB: last sync time
            JOB->>SL: isOlderThan (24 hours)
            SL-->>JOB: true or false
            opt last sync is older than 24 hours
                JOB->>NTF: compose (stale-sync alert for the pharmacy account)
                NTF-->>JOB: message ready
                JOB->>NTF: send ()
                NTF->>EA: sendEmail (alert)
                alt email accepted
                    EA-->>NTF: sent
                    Note over EA: The email service delivers the alert to the manager's inbox
                else email failed
                    EA-->>NTF: failed
                    NTF->>NTF: markFailed ()
                end
            end
        end
    end

    %% ---------- Part 4: failed emails are tried again so no alert gets lost ----------
    JOB->>JOB: retryFailedEmails ()
    opt a previous alert is marked as failed
        JOB->>NTF: retry ()
        NTF->>EA: sendEmail (alert)
        EA-->>NTF: sent
    end